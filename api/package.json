{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "Modular Express.js API server for Portfolio project",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "pre:dev": "cd scripts && node -r ts-node/register pre-build.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "prebuild": "cd scripts && node -r ts-node/register pre-build.ts",
    "prebuild:prod": "cd scripts && cross-env NODE_ENV=production node -r ts-node/register pre-build.ts",
    "build:prod": "tsc",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "swagger": "ts-node scripts/generate-swagger.ts"
  },
  "keywords": [
    "api",
    "express",
    "typescript",
    "rest"
  ],
  "author": "Portfolio API",
  "license": "MIT",
  "dependencies": {
    "awilix": "^10.0.2",
    "awilix-express": "^8.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.3",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.5",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.6",
    "@types/node": "^20.8.0",
    "@types/supertest": "^2.0.14",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "cross-env": "^10.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
